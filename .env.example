# Optional: SportsData.io API key for standings and stats (scores use ESPN and do not require this).
# Get a key at https://sportsdata.io
# Copy this file to .env and add your key: SPORTSDATA_API_KEY=your_key_here
SPORTSDATA_API_KEY=

# Firebase Web App config for Auth + Firestore message board.
# These are public client config values, not private secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
